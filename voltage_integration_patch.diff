+static void voltage_recv_position_data(zmq::socket_t & socket,
+                                      struct ggml_tensor * tensor,
+                                      uint32_t expected_start,
+                                      uint32_t expected_end) {
+    std::vector<zmq::message_t> recv_msgs;
+    if (!zmq::recv_multipart(socket, std::back_inserter(recv_msgs))) {
+        LLAMA_LOG_ERROR("Failed to receive Voltage position data\n");
+        return;
+    }
+    
+    // Parse position metadata
+    uint32_t start_pos = *(uint32_t*)recv_msgs[1].data();
+    uint32_t end_pos = *(uint32_t*)recv_msgs[3].data();
+    
+    GGML_ASSERT(start_pos == expected_start && end_pos == expected_end);
+    
+    // Copy tensor data
+    std::memcpy(ggml_get_data(tensor), recv_msgs[5].data(), recv_msgs[5].size());
+}
